# ==============================================================================
# Google Cloud Dataproc Workshop — Example Configuration (.env.example)
# Copy this file to `.env` and replace with your actual GCP project values:
#   cp .env.example .env
# ==============================================================================

# --- 1. Core Google Cloud Project Settings ---
GCP_PROJECT_ID="poc-example-ds"
GCP_REGION="europe-west1"
GCP_ZONE="europe-west1-b"
BQ_LOCATION="EU"

# --- 2. Dataproc Cluster & Networking Settings ---
DATAPROC_CLUSTER_NAME="example-dataproc-cluster"
DATAPROC_IMAGE_VERSION="2.2-debian12"
MASTER_MACHINE_TYPE="e2-standard-4"
WORKER_MACHINE_TYPE="e2-standard-4"
WORKER_BOOT_DISK_SIZE="500"
SUBNET_NAME="default"

# --- 3. Cloud Storage & BigQuery ETL Settings ---
DATAPROC_BUCKET="example-dataproc-workshop"
SPARK_TEMP_BUCKET="example-dataproc-workshop"
BQ_DATASET_ID="example_composer_workshop"
BQ_INPUT_TABLE_ID="poc-example-ds.example_composer_workshop.sales_data"
BQ_OUTPUT_TABLE_ID="poc-example-ds.example_composer_workshop.filtered_sales"
DEFAULT_PROCESSING_DATE="2025-06-12"
